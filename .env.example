DATABASE_URL=sqlite:///./tracking.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# true = driver OTP is returned in the API response (no SMS provider needed). Set false in production.
DEV_MODE=true
CORS_ORIGINS=*

# Location ingestion (same defaults as nammayatri location-tracking-service)
MIN_LOCATION_ACCURACY_M=50
LOCATION_BATCH_SIZE=100

# Trip automation / alerts
IN_TRANSIT_DISTANCE_M=300
REACHED_RADIUS_M=300
DEVIATION_THRESHOLD_M=1000
DEVIATION_THRESHOLD_STRAIGHT_LINE_M=5000
STALE_LOCATION_MINUTES=10
DELAY_GRACE_MINUTES=15
ALERT_CHECK_INTERVAL_SEC=60

# ETA / routing. OSRM_URL e.g. http://localhost:5000 (nammayatri/osrm-backend); empty = straight-line estimate
DEFAULT_SPEED_KMPH=40
ROAD_FACTOR=1.3
OSRM_URL=

# Customer tracking links point at the Streamlit dashboard
TRACKING_LINK_TTL_HOURS=168
PUBLIC_TRACKING_BASE_URL=http://localhost:8501

UPLOAD_DIR=./uploads

# Optional email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=tracking@example.com
