DATABASE_URL=sqlite:///./tracking.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# true = driver OTP is returned in the API response (no SMS provider needed). Set false in production.
DEV_MODE=true
CORS_ORIGINS=*

# Location ingestion (same defaults as nammayatri location-tracking-service)
MIN_LOCATION_ACCURACY_M=50
LOCATION_BATCH_SIZE=100

# Trip automation / alerts
IN_TRANSIT_DISTANCE_M=300
REACHED_RADIUS_M=300
DEVIATION_THRESHOLD_M=1000
DEVIATION_THRESHOLD_STRAIGHT_LINE_M=5000
STALE_LOCATION_MINUTES=10
DELAY_GRACE_MINUTES=15
ALERT_CHECK_INTERVAL_SEC=60

# ETA / routing. OSRM_URL e.g. http://localhost:5000 (nammayatri/osrm-backend); empty = straight-line estimate
DEFAULT_SPEED_KMPH=40
ROAD_FACTOR=1.3
OSRM_URL=

# Customer tracking links point at the Streamlit dashboard
TRACKING_LINK_TTL_HOURS=168
PUBLIC_TRACKING_BASE_URL=http://localhost:8501

# Consent-based SIM tracking (see README "Connecting a real SIM tracking provider")
# mock = simulated aggregator for development. aggregator = app/services/sim/providers.py AggregatorProvider.
SIM_PROVIDER=mock
SIM_API_BASE_URL=
SIM_API_KEY=
# Shared secret for X-Signature (HMAC-SHA256) on POST /integrations/sim/webhook. Generate: openssl rand -hex 32
SIM_WEBHOOK_SECRET=
SIM_AUTO_CONSENT=true
# Pings are billed per request: on-trip drivers every 10 min, idle drivers hourly (0 = never ping idle drivers)
SIM_PING_ON_TRIP_MIN=10
SIM_PING_IDLE_MIN=60
SIM_POLL_TICK_SEC=30
SIM_PENDING_CONSENT_HOURS=48
SIM_CONSENT_VALIDITY_DAYS=180
# Network fixes are approximate (300 m - 3 km), so SIM points use wider radii
SIM_MAX_ACCURACY_M=5000
SIM_IN_TRANSIT_DISTANCE_M=3000
SIM_REACHED_RADIUS_M=2000
SIM_STALE_AFTER_PINGS=2.5

UPLOAD_DIR=./uploads

# Optional email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=tracking@example.com
